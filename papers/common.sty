% ============================================================
% 10. ЗАГОЛОВКИ (п. 4.1.2, 4.1.4–4.1.7 СТО)
% ============================================================
\usepackage{titlesec}

% Раздел: с новой страницы, по центру, прописными, без точки, без полужирного
\titleformat{\section}[block]
  {\normalfont\centering}
  {\thesection.}{0.5em}{\MakeUppercase}
\titlespacing*{\section}{0pt}{0pt}{12pt}

% Подраздел: с прописной, без точки
\titleformat{\subsection}[block]
  {\normalfont}
  {\thesubsection.}{0.5em}{}
\titlespacing*{\subsection}{0pt}{12pt}{6pt}

% Пункт: с прописной, без точки
\titleformat{\subsubsection}[block]
  {\normalfont}
  {\thesubsubsection.}{0.5em}{}
\titlespacing*{\subsubsection}{0pt}{12pt}{6pt}

% Структурные элементы (РЕФЕРАТ, СОДЕРЖАНИЕ, ВВЕДЕНИЕ, ...):
% с новой страницы, по центру, прописными, без точки.
\newcommand{\structtitle}[1]{%
  \clearpage
  \begin{center}
    \MakeUppercase{#1}
  \end{center}
  \par\vspace{6pt}%
}

