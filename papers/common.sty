\usepackage{geometry}
\geometry{left=30mm,right=15mm,top=20mm,bottom=20mm}

% ============================================================
% 3. ИНТЕРВАЛ, ОТСТУП, ВЫРАВНИВАНИЕ (п. 3.2 СТО)
% ============================================================
\usepackage{setspace}
\onehalfspacing

\usepackage{indentfirst}
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{0pt}

% ============================================================
% 4. ШРИФТ 14 pt (п. 3.2 СТО: кегль 12–14)
% ============================================================
\makeatletter
\renewcommand\normalsize{%
  \@setfontsize\normalsize{14pt}{21pt}%
  \abovedisplayskip 14\p@ \@plus3\p@ \@minus7\p@
  \abovedisplayshortskip \z@ \@plus3\p@
  \belowdisplayshortskip 7\p@ \@plus3\p@ \@minus4\p@
  \belowdisplayskip \abovedisplayskip
  \let\@listi\@listI}
\normalsize
\makeatother

% ============================================================
% 5. МАТЕМАТИКА, ТЕОРЕМЫ
